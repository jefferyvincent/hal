Python:
import requests
import json
from datetime import datetime, timedelta
import time
import threading

# Configuration
account_sid = 'ACaa56e646f28a89096769013b74d6fcc9'
auth_token = '696ed6a8d53512c639e5c34d610516e8'
from_number = '+17577994531'
to_number = '+19082952749'

def send_sms(message):
    url = f'https://{account_sid}:{auth_token}@api.twilio.com/2010-04-01/Accounts/{account_sid}/Messages.json'
    data = {'From': from_number, 'To': to_number, 'Body': message}
    response = requests.post(url, data=data)
    return response.status_code == 201

def get_spy_options_data():
    """Get SPY options chain data"""
    url = 'https://data.massive.dev/v3/snapshot/options/SPY'
    response = requests.get(url)
    if response.status_code == 200:
        return response.json()
    return None

def check_unusual_activity():
    """Check for unusual options activity"""
    data = get_spy_options_data()
    if not data:
        return
    
    alerts = []
    
    # Check for high volume/IV contracts
    for contract in data.get('options', []):
        try:
            volume = contract.get('volume', 0)
            open_interest = contract.get('open_interest', 0)
            iv = contract.get('implied_volatility', 0)
            strike = contract.get('strike_price', 0)
            option_type = contract.get('contract_type', '')
            
            # Alert on unusual volume (>1000) or high IV (>30%)
            if volume > 1000 or (iv and iv > 30):
                alerts.append(f"SPY {option_type.upper()} ${strike} - Volume: {volume}, IV: {iv:.2f}%")
        except:
            continue
    
    if alerts:
        message = f"SPY Options Alert: {len(alerts)} unusual contracts detected. Check dashboard for details."
        send_sms(message)
        print(f'{datetime.now()}: Alert sent - {len(alerts)} unusual contracts')

# Run initial check
check_unusual_activity()

# Schedule recurring checks every 5 minutes
def monitor_loop():
    while True:
        time.sleep(300)  # 5 minutes
        check_unusual_activity()

thread = threading.Thread(target=monitor_loop, daemon=True)
thread.start()

print("SPY options monitoring started")
