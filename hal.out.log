# Create the PowerShell script for email integration
script_content = '''# Email Integration Script for HAL
# This script reads recent emails from your Microsoft 365 inbox

# Prerequisites:
# 1. Install Microsoft Graph PowerShell SDK: Install-Module Microsoft.Graph -Scope CurrentUser
# 2. Register an Azure AD app with Mail.Read permissions
# 3. Replace the app ID and tenant ID below

# Configuration
$appId = "YOUR_APP_ID_HERE"
$tenantId = "YOUR_TENANT_ID_HERE"

# Connect to Microsoft Graph
Connect-MgGraph -Scopes "Mail.Read" -ClientId $appId -TenantId $tenantId

# Get recent emails (last 10)
$emails = Get-MgUserMessage -UserId "me" -Top 10 -Property Subject,From,ReceivedDateTime,BodyPreview

Write-Host "=== Recent Emails ===" -ForegroundColor Green
foreach ($email in $emails) {
    Write-Host "From: $($email.From.EmailAddress.Address)"
    Write-Host "Subject: $($email.Subject)"
    Write-Host "Received: $($email.ReceivedDateTime)"
    Write-Host "Preview: $($email.BodyPreview)"
    Write-Host "---"
}

# Disconnect when done
Disconnect-MgGraph
'''

with open(r'D:\hal_scratch\email_integration.ps1', 'w', encoding='utf-8') as f:
    f.write(script_content)

print("Script created successfully at D:\\hal_scratch\\email_integration.ps1")
print("\nNext steps:")
print("1. Install Microsoft Graph module: Install-Module Microsoft.Graph -Scope CurrentUser")
print("2. Register Azure AD app at https://portal.azure.com")
print("3. Grant Mail.Read permissions")
print("4. Update the script with your app ID and tenant ID")
