Python:
script = r'''#requires -Modules Microsoft.Graph

# Configuration
$AppId = "YOUR_APP_ID"
$TenantId = "YOUR_TENANT_ID"
$ClientSecret = "YOUR_CLIENT_SECRET"

# Connect to Microsoft Graph
try {
    Connect-MgGraph -ClientId $AppId -ClientSecret $ClientSecret -TenantId $TenantId -NoWelcome
    Write-Host "Connected to Microsoft Graph" -ForegroundColor Green
}
catch {
    Write-Host "Failed to connect: $_" -ForegroundColor Red
    exit
}

# Get recent emails
try {
    $emails = Get-MgUserMessage -UserId "me" -Top 5 -Property Subject,From,ReceivedDateTime,BodyPreview
    foreach ($email in $emails) {
        Write-Host "Subject: $($email.Subject)"
        Write-Host "From: $($email.From.EmailAddress.Address)"
        Write-Host "Received: $($email.ReceivedDateTime)"
        Write-Host "Preview: $($email.BodyPreview)"
        Write-Host "---"
    }
}
catch {
    Write-Host "Failed to get emails: $_" -ForegroundColor Red
}

# Disconnect
Disconnect-MgGraph
Write-Host "Disconnected from Microsoft Graph" -ForegroundColor Green
'''

with open(r"D:\hal_scratch\email_integration.ps1", "w") as f:
    f.write(script)
print("Script updated.")
