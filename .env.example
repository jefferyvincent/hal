# HAL configuration — copy to `.env` and edit.
# Real `.env` is gitignored; this template is committed.
# More keys (paths, models, voice) get wired during the Ubuntu port —
# see HAL/HAL-config-design.md.

# ---- Secrets ----
MASSIVE_API_KEY=
TWILLO_SMS=

# ---- Identity ----  (defaults below reproduce current behavior)
HAL_USER_NAME=Jeffery
HAL_NAME=HAL
HAL_VERSION=9000            # name + version compose HAL's designation, e.g. "HAL 9000"

# ---- Obsidian vault (corpus: rules / journal / theses / watchlist) ----
HAL_VAULT=C:/Users/Gamer/HAL-Vault

# ---- Market / news (already env-driven) ----
NEWS_POLL_SECONDS=300
NEWS_PRIMARY_FEED=yahoo
CHART_DATA_SOURCE=yahoo
