# HAL configuration — copy to `.env` and edit. Real `.env` is gitignored.
# Lines are KEY=value. Inline `# comments` and surrounding quotes are stripped.
# Anything left unset falls back to the default shown in the comment.

# ---- Secrets ----
TWILLO_SMS=

# ---- LAN access auth ----
# When HAL_PASSWORD is set, devices on the network must log in before they can
# reach the UI or WebSocket; this machine (localhost / Tauri) is always exempt.
# Leave HAL_PASSWORD empty to disable auth entirely. Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
HAL_PASSWORD=
HAL_SECRET_KEY=

# ---- Alpaca (order execution + ALL market data) ----
# HAL places equity + single-leg option orders through Alpaca, and the SAME key
# pair serves every market-data read: stock bars, option chains with greeks/IV,
# expired-contract discovery for the backtester, the market clock, and both live
# WebSocket feeds. There is no second data provider to pay for.
#
# ALPACA_PAPER decides paper vs live (true = paper account, the safe default —
# nothing hits real money). ALPACA_AUTOPILOT picks the order gate: false stages
# every order for an explicit confirm; true submits as soon as the rules gate
# passes. Both are togglable at runtime (HAL: "turn on autopilot").
# ALPACA_BASE_URL is no longer read — the SDK derives the host from
# ALPACA_PAPER — kept for reference.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_AUTOPILOT=false
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Data feeds. The free tier is the default and is fully functional; these only
# need changing if you add a paid entitlement.
#   ALPACA_STOCK_FEED   iex (free real-time, IEX tape only) | sip (paid, full
#                       consolidated tape). Historical bars older than ~15 min
#                       come from SIP either way — only the live window differs.
#   ALPACA_OPTION_FEED  indicative (free; DOES carry greeks + implied vol) |
#                       opra (real-time OPRA NBBO — requires the paid Algo
#                       Trader Plus plan, $99/mo; on Basic every call 403s with
#                       "OPRA agreement is not signed", which is a subscription
#                       gate, not a form you can sign for free).
# Note: option history begins 2024-01-18, which bounds how far back the
# backtester and optimizer can run.
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# ---- Risk engine ----  portfolio circuit breakers in front of new entries
# (the runaway guard for autopilot). Exits/closes are never gated. Set any to 0
# to disable that check. Daily-loss latches a kill switch that blocks new
# entries — and drops autopilot back to confirm — until reset from the HUD.
RISK_MAX_ORDERS_PER_MIN=6
RISK_MAX_OPEN_POSITIONS=20
RISK_MAX_GROSS_EXPOSURE_PCT=200
RISK_DAILY_LOSS_LIMIT_PCT=10
# Concentration ceilings. The caps above count SPY, QQQ and IWM as three
# independent positions; these catch the case where they are one bet.
#   SYMBOL — max exposure to any single underlying (stacked strikes on a name)
#   GROUP  — max exposure across a correlated basket (see risk._CORRELATED_GROUPS)
# Both scale DOWN automatically when the underlying's realized vol is high in its
# own trailing-year range: x0.75 above the 60th percentile, x0.5 above the 80th.
RISK_MAX_SYMBOL_EXPOSURE_PCT=60
RISK_MAX_GROUP_EXPOSURE_PCT=100

# ---- Identity ----  (defaults reproduce current behavior)
HAL_USER_NAME=Jeffery
HAL_NAME=HAL
# name + version compose HAL's designation, e.g. "HAL 9000"
HAL_VERSION=9000
# who built HAL — HAL will name this person if asked who created it
HAL_CREATOR=Jeffery Vincent

# ---- Obsidian vault (corpus: rules / journal / theses / watchlist) ----
# HAL_VAULT_DIR is the path HAL actually reads (RAG, rules, persistence);
# defaults to ~/HAL-Vault. HAL_VAULT feeds a legacy constant — keep it in sync.
HAL_VAULT_DIR=/home/youruser/HAL-Vault
HAL_VAULT=/home/youruser/HAL-Vault

# ---- Market / news ----
NEWS_POLL_SECONDS=300
NEWS_PRIMARY_FEED=yahoo
# Chart bars: yahoo (keyless, near-real-time) or alpaca (uses ALPACA_STOCK_FEED).
CHART_DATA_SOURCE=yahoo

# ---- Pre-earnings IV-crush screener ----
# Background scan that flags watchlist names reporting soon whose options are
# overpriced (IV well above realized vol). Earnings dates come from a keyless
# Nasdaq feed. EARNINGS_POLL_SECONDS = scan interval (default hourly);
# EARNINGS_LOOKAHEAD_DAYS = how soon a report must fall to be in scope.
EARNINGS_POLL_SECONDS=3600
EARNINGS_LOOKAHEAD_DAYS=3

# ---- Reddit social sentiment (optional) ----
# Reddit blocks keyless access, so HAL uses app-only OAuth. Create a free app at
# https://www.reddit.com/prefs/apps (type: "script"), then paste its client id
# (under the app name) and secret here. Leave blank to disable the Reddit read.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Ollama model store (~30 GB of blobs) ----
# Where the daemon keeps models; applied to the systemd service by setup.sh.
# Leave unset for Ollama's default; set to keep blobs off the system disk.
OLLAMA_MODELS=/path/to/ollama-models

# ---- Ollama endpoint + which models HAL uses ----
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_VISION_FAST_MODEL=qwen2.5vl:3b

# ---- Scratch root: RAG index, SQLite, saved conversations, TTS voices ----
# Derived, fully-rebuildable data. Prefer a fast local (ext4) disk over NTFS —
# SQLite/LanceDB file-locking is happier there. Defaults to ~/hal_scratch.
# Override any single path with HAL_RAG_DB_DIR / HAL_CONVERSATIONS_DIR /
# HAL_DB_PATH / HAL_PIPER_VOICE_PATH (each defaults under HAL_SCRATCH_DIR).
HAL_SCRATCH_DIR=/home/youruser/hal_scratch

# ---- Voice (TTS / STT) ----
HAL_SPEAKER=Damien Black            # XTTS studio speaker; blank = clone HAL_REFERENCE_WAV
HAL_REFERENCE_WAV=static/hal_reference.bak.wav
WHISPER_MODEL_SIZE=medium
TTS_PITCH_SHIFT_STEPS=0             # negative = deeper voice; 0 disables

# ---- Windows only ----
# FFmpeg shared-DLL dir for torchcodec (winget install Gyan.FFmpeg.Shared).
# Ignored on Linux (ffmpeg comes from the system libs). Leave unset elsewhere.
# HAL_FFMPEG_DLL_DIR=C:\path\to\ffmpeg\bin
